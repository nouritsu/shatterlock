#!/usr/bin/env sh
# Wrap a slot shader (one that defines `vec4 shade(vec2 uv)`) into a complete Qt 440 fragment
# shader on stdout. Errors from qsb then point at the user's file as source string 1.
set -eu

root=$(cd "$(dirname "$0")/.." && pwd)
prelude="${SHATTERLOCK_PRELUDE:-$root/src/shaders/prelude.glsl}"

cat "$prelude"
printf '#line 1 1\n'
cat "$1"
printf '\n#line 1 2\nvoid main() { fragColor = shade(qt_TexCoord0) * qt_Opacity; }\n'
