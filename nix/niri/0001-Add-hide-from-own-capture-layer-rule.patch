+    /// Returns the id of `client` if it has layer surfaces on `output` that are hidden from its
+    /// own screen captures.
+    fn client_hiding_layers_from_capture(
+        &self,
+        output: &Output,
+        client: Option<Client>,
+    ) -> Option<ClientId> {
+        let id = client?.id();
+        let layer_map = layer_map_for_output(output);
+        let hides = layer_map.layers().any(|surface| {
+            self.mapped_layer_surfaces
+                .get(surface)
+                .is_some_and(|mapped| mapped.is_hidden_from_capture(Some(&id)))
+        });
+        hides.then_some(id)
+    }
