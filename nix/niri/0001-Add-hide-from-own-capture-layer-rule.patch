+    /// Returns whether this surface is left out of a screen capture made by `client`.
+    pub fn is_hidden_from_capture(&self, client: Option<&ClientId>) -> bool {
+        let Some(client) = client else {
+            return false;
+        };
+
+        self.rules.hide_from_own_capture
+            && self
+                .surface
+                .wl_surface()
+                .client()
+                .is_some_and(|c| c.id() == *client)
+    }
+
     pub fn bob_offset(&self) -> Point<f64, Logical> {
         if !self.rules.baba_is_float {
             return Point::from((0., 0.));
@@ -192,6 +208,10 @@ impl MappedLayer {
